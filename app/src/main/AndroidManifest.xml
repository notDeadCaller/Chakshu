<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Microphone: audio recording during incident -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- SMS: send SOS alert to contacts and 112 without internet -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Vibration: haptic feedback on trigger and cancellation -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Foreground service: keep recording alive while app is backgrounded -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Wake lock: prevent CPU sleep mid-recording -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Network state: determine network type for incident metadata -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Post notifications: required on API 33+ for the accessibility-disabled alert -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Telephony hardware is not required — app works on Wi-Fi-only / Chrome OS devices -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".ChakshuApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chakshu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Chakshu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service with MICROPHONE type for audio recording -->
        <service
            android:name=".core.services.ChakshuForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Accessibility service intercepts volume key events on lock screen -->
        <service
            android:name=".core.platform.TriggerAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- WorkManager on-demand init: ChakshuApplication implements Configuration.Provider.
             Remove the default WorkManagerInitializer so WorkManager does not auto-initialise. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
